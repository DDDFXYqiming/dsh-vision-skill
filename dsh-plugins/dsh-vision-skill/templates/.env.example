# 视觉模型配置：复制本文件为技能目录下的 .env，脚本启动时自动加载
# 也可直接导出为环境变量；环境变量优先级高于 .env 文件
# 所有具体参数留空，按你的环境填写；不要提交真实 Key 到仓库
VISION_API_URL=  # 主 provider 完整接口地址（含路径），如 https://api.example.com/v1/chat/completions
VISION_MODEL=
VISION_API_KEY=
VISION_THINKING=disabled   # disabled | adaptive | off；off = 不发送 thinking 字段
VISION_TIMEOUT=180         # 秒

# 多 provider failover（可选）。JSON 数组，顺序 = 优先级；主 provider 失败后依次尝试。
# 插件模式（dsh-vision-skill）在 config.visionProviders 配置同名结构，无需此处手写。
VISION_PROVIDERS_JSON=

# 长截图 OCR 本地快路径（可选）。未安装 tesseract 时自动回退 VLM。
TESSERACT_BIN=tesseract
TESSERACT_LANGS=chi_sim+eng
TESSERACT_TIMEOUT=120
